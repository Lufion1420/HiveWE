# Smoke test of `HiveWE --resave`, called from tests/CMakeLists.txt with HIVEWE_EXE, INPUT and OUTPUT.
# INPUT is copied to a sandbox first, so nothing is ever written next to it.
get_filename_component(exe_dir "${HIVEWE_EXE}" DIRECTORY)
set(sandbox "${OUTPUT}_input")

function(run_resave out_result out_errors)
	execute_process(
		COMMAND "${HIVEWE_EXE}" --resave ${ARGN}
		WORKING_DIRECTORY "${exe_dir}"
		RESULT_VARIABLE result
		OUTPUT_QUIET
		ERROR_VARIABLE errors
		TIMEOUT 240
	)
	set(${out_result} "${result}" PARENT_SCOPE)
	set(${out_errors} "${errors}" PARENT_SCOPE)
endfunction()

if(NOT EXISTS "${exe_dir}/data")
	message("RESAVE_SMOKE_SKIPPED: no data folder next to ${HIVEWE_EXE}")
	return()
endif()

# Wrong argument count: exit 2, before CASC is opened.
run_resave(result errors "${INPUT}")
if(NOT result EQUAL 2)
	message(FATAL_ERROR "--resave with one argument exited with ${result}, expected 2: ${errors}")
endif()

file(REMOVE_RECURSE "${OUTPUT}" "${sandbox}")
file(COPY "${INPUT}/" DESTINATION "${sandbox}")

run_resave(result errors "${sandbox}" "${OUTPUT}")
if(result EQUAL 4)
	message("RESAVE_SMOKE_SKIPPED: ${errors}")
	return()
endif()
if(NOT result EQUAL 0)
	message(FATAL_ERROR "HiveWE --resave exited with ${result}: ${errors}")
endif()
foreach(name war3map.w3i war3map.w3e war3map.wpm war3map.doo war3mapUnits.doo war3map.wtg war3map.j)
	if(NOT EXISTS "${OUTPUT}/${name}")
		message(FATAL_ERROR "HiveWE --resave did not write ${name}")
	endif()
endforeach()
file(SIZE "${OUTPUT}/war3map.w3i" w3i_size)
if(w3i_size EQUAL 0)
	message(FATAL_ERROR "war3map.w3i is empty")
endif()

# The output folder is now non-empty: refused.
run_resave(result errors "${sandbox}" "${OUTPUT}")
if(NOT result EQUAL 1)
	message(FATAL_ERROR "--resave into a non-empty folder exited with ${result}, expected 1: ${errors}")
endif()

# An output folder inside the input: refused before anything is created.
run_resave(result errors "${sandbox}" "${sandbox}/nested")
if(NOT result EQUAL 1 OR EXISTS "${sandbox}/nested")
	message(FATAL_ERROR "--resave into a folder inside the input exited with ${result}, expected 1: ${errors}")
endif()

# The output folder equal to the input: refused.
run_resave(result errors "${sandbox}" "${sandbox}")
if(NOT result EQUAL 1)
	message(FATAL_ERROR "--resave into the input folder exited with ${result}, expected 1: ${errors}")
endif()

# A doodad whose skin differs from its id keeps the skin through load, save and the script (the post-load Doodad::init used to
# reset it). Fixture: FTtw skinned as LTlt (skin at byte 52, with an item set so the script creates it), then LTlt skinned as
# LTlt (skin at byte 118). Both are fixed-Z so the records do not depend on terrain height.
file(COPY_FILE "${SKINNED_DOO}" "${sandbox}/war3map.doo")
set(skin_output "${OUTPUT}_skin")
file(REMOVE_RECURSE "${skin_output}")
run_resave(result errors "${sandbox}" "${skin_output}")
if(NOT result EQUAL 0)
	message(FATAL_ERROR "--resave with a skinned doodad exited with ${result}: ${errors}")
endif()
file(READ "${SKINNED_DOO}" doo_in HEX)
file(READ "${skin_output}/war3map.doo" doo_out HEX)
string(SUBSTRING "${doo_out}" 104 8 changed_skin)
string(SUBSTRING "${doo_out}" 236 8 same_skin)
if(NOT changed_skin STREQUAL "4c546c74" OR NOT same_skin STREQUAL "4c546c74")
	message(FATAL_ERROR "war3map.doo skins after resave: ${changed_skin} and ${same_skin}, expected 4c546c74 (LTlt) for both")
endif()
if(NOT doo_out STREQUAL doo_in)
	message(FATAL_ERROR "war3map.doo with skinned doodads changed on resave:\n${doo_in}\n${doo_out}")
endif()
file(READ "${skin_output}/war3map.j" skin_script)
string(FIND "${skin_script}" "BlzCreateDestructableZWithSkin('FTtw'" create_call)
string(FIND "${skin_script}" "'LTlt')" skin_argument)
if(create_call EQUAL -1 OR skin_argument EQUAL -1)
	message(FATAL_ERROR "war3map.j does not create FTtw with skin LTlt")
endif()
file(REMOVE_RECURSE "${skin_output}")
file(COPY_FILE "${INPUT}/war3map.doo" "${sandbox}/war3map.doo")

# An ability field the object data writer cannot write (anam with data pointer 1 loads as "namea", which has no meta data id):
# refused before anything is copied or written, so the output folder stays empty.
file(COPY_FILE "${UNWRITABLE_W3A}" "${sandbox}/war3map.w3a")
set(refused_output "${OUTPUT}_refused")
file(REMOVE_RECURSE "${refused_output}")
run_resave(result errors "${sandbox}" "${refused_output}")
if(NOT result EQUAL 1 OR NOT errors MATCHES "Save refused: war3map.w3a object AHbz field namea")
	message(FATAL_ERROR "--resave with an unwritable ability field exited with ${result}, expected 1 and a refusal: ${errors}")
endif()
file(GLOB refused_files "${refused_output}/*")
if(refused_files)
	message(FATAL_ERROR "--resave refused the save but wrote into the output folder: ${refused_files}")
endif()
file(REMOVE_RECURSE "${refused_output}")

if(EXISTS "${INPUT}/war3map.w3a")
	file(COPY_FILE "${INPUT}/war3map.w3a" "${sandbox}/war3map.w3a")
else()
	file(REMOVE "${sandbox}/war3map.w3a")
endif()

# A custom unit h0zz based on the unknown id Zzzz is skipped on load and dropped on save: the output is written, exit code 5.
# The fixture's w3u replaces the sandbox's own one, so the skipped unit is the only object-data change.
file(COPY_FILE "${UNKNOWN_BASE_W3U}" "${sandbox}/war3map.w3u")
set(skipped_output "${OUTPUT}_skipped")
file(REMOVE_RECURSE "${skipped_output}")
run_resave(result errors "${sandbox}" "${skipped_output}")
if(NOT result EQUAL 5 OR NOT errors MATCHES "Skipped 1 custom object")
	message(FATAL_ERROR "--resave with an unknown base id exited with ${result}, expected 5 and the skipped warning: ${errors}")
endif()
if(NOT EXISTS "${skipped_output}/war3map.w3i" OR NOT EXISTS "${skipped_output}/war3map.w3e")
	message(FATAL_ERROR "--resave with an unknown base id exited 5 but did not write the map")
endif()
if(NOT EXISTS "${skipped_output}/war3map.w3u")
	message(FATAL_ERROR "--resave with an unknown base id exited 5 but wrote no war3map.w3u")
endif()
file(READ "${skipped_output}/war3map.w3u" skipped_w3u_hex HEX)
if(skipped_w3u_hex MATCHES "68307a7a")
	message(FATAL_ERROR "--resave with an unknown base id still wrote the skipped unit h0zz to war3map.w3u")
endif()
file(REMOVE_RECURSE "${skipped_output}")
if(EXISTS "${INPUT}/war3map.w3u")
	file(COPY_FILE "${INPUT}/war3map.w3u" "${sandbox}/war3map.w3u")
else()
	file(REMOVE "${sandbox}/war3map.w3u")
endif()

# Lua maps: the generated war3map.lua is syntax-checked. The fixture w3i is data/test map's with the script type set to Lua.
# Control: the generated Lua script parses, exit 0. Then a map header with a syntax error: the rest is saved, no war3map.lua is
# written (the sandbox has none to keep), exit 3, and stderr names the line's region.
file(COPY_FILE "${LUA_W3I}" "${sandbox}/war3map.w3i")
set(lua_output "${OUTPUT}_lua")
file(REMOVE_RECURSE "${lua_output}")
run_resave(result errors "${sandbox}" "${lua_output}")
if(NOT result EQUAL 0 OR NOT EXISTS "${lua_output}/war3map.lua")
	message(FATAL_ERROR "--resave of a Lua map exited with ${result}, expected 0 and a war3map.lua: ${errors}")
endif()
file(REMOVE_RECURSE "${lua_output}")
# Golden: the whole generated war3map.lua for a map header (CRLF lines), an initialised variable, a GUI trigger and a GUI trigger
# converted to custom text, byte for byte. lua_golden.lua was checked equal to the output of the build before the syntax check.
# Parts come from the game data in CASC (SetDayNightModels, sound environment), so a different game version can change them.
file(COPY_FILE "${LUA_GOLDEN_WTG}" "${sandbox}/war3map.wtg")
file(COPY_FILE "${LUA_GOLDEN_WCT}" "${sandbox}/war3map.wct")
run_resave(result errors "${sandbox}" "${lua_output}")
if(NOT result EQUAL 0)
	message(FATAL_ERROR "--resave of the golden Lua map exited with ${result}, expected 0: ${errors}")
endif()
execute_process(COMMAND ${CMAKE_COMMAND} -E compare_files "${LUA_GOLDEN}" "${lua_output}/war3map.lua" RESULT_VARIABLE golden_differs)
if(NOT golden_differs EQUAL 0)
	message(FATAL_ERROR "The generated war3map.lua differs from ${LUA_GOLDEN}; the new output is ${lua_output}/war3map.lua")
endif()
file(REMOVE_RECURSE "${lua_output}")
file(COPY_FILE "${INPUT}/war3map.wtg" "${sandbox}/war3map.wtg")
file(COPY_FILE "${BROKEN_LUA_WCT}" "${sandbox}/war3map.wct")
run_resave(result errors "${sandbox}" "${lua_output}")
if(NOT result EQUAL 3 OR NOT errors MATCHES "Lua syntax error at line [0-9]+ \\(Map header\\)")
	message(FATAL_ERROR "--resave of a Lua map with a broken map header exited with ${result}, expected 3 and the syntax error: ${errors}")
endif()
if(NOT EXISTS "${lua_output}/war3map.w3i" OR EXISTS "${lua_output}/war3map.lua")
	message(FATAL_ERROR "--resave of a Lua map with a broken map header: expected the map saved without a war3map.lua")
endif()
file(REMOVE_RECURSE "${lua_output}")
file(COPY_FILE "${INPUT}/war3map.w3i" "${sandbox}/war3map.w3i")
file(COPY_FILE "${INPUT}/war3map.wct" "${sandbox}/war3map.wct")

# A map with a script but no war3map.wtg (script-only or protected): the save keeps the script byte for byte, writes no trigger
# files and says so on stderr, exit 0. Once with the script in the root, once under scripts\ only, and once with war3map.wtg but no
# war3map.wct (the map header code lives only in the wct, so a generated script would lose it; the wtg stays as it was).
set(kept_marker "// HiveWE resave_smoke: hand-written script that must survive\r\n")
foreach(kept_case root scripts nowct)
	file(REMOVE_RECURSE "${sandbox}")
	file(COPY "${INPUT}/" DESTINATION "${sandbox}")
	if(kept_case STREQUAL "nowct")
		file(REMOVE "${sandbox}/war3map.wct")
	else()
		file(REMOVE "${sandbox}/war3map.wtg" "${sandbox}/war3map.wct")
	endif()
	file(READ "${INPUT}/war3map.j" kept_script)
	string(PREPEND kept_script "${kept_marker}")
	if(NOT kept_case STREQUAL "scripts")
		set(kept_name "war3map.j")
	else()
		set(kept_name "scripts/war3map.j")
		file(REMOVE "${sandbox}/war3map.j")
	endif()
	file(WRITE "${sandbox}/${kept_name}" "${kept_script}")
	file(SHA256 "${sandbox}/${kept_name}" kept_hash_in)

	set(kept_output "${OUTPUT}_kept_${kept_case}")
	file(REMOVE_RECURSE "${kept_output}")
	run_resave(result errors "${sandbox}" "${kept_output}")
	if(NOT result EQUAL 0 OR NOT errors MATCHES "Saving keeps the map script exactly as it is")
		message(FATAL_ERROR "--resave of a map without war3map.wtg (${kept_case}) exited with ${result}, expected 0 and the kept-script notice: ${errors}")
	endif()
	if(NOT EXISTS "${kept_output}/war3map.w3i")
		message(FATAL_ERROR "--resave of a map without war3map.wtg (${kept_case}) did not write the map")
	endif()
	file(SHA256 "${kept_output}/${kept_name}" kept_hash_out)
	if(NOT kept_hash_out STREQUAL kept_hash_in)
		message(FATAL_ERROR "--resave of a map without war3map.wtg changed ${kept_name}")
	endif()
	if(kept_case STREQUAL "nowct")
		file(SHA256 "${INPUT}/war3map.wtg" wtg_hash_in)
		file(SHA256 "${kept_output}/war3map.wtg" wtg_hash_out)
		if(NOT wtg_hash_out STREQUAL wtg_hash_in)
			message(FATAL_ERROR "--resave of a map without war3map.wct rewrote war3map.wtg")
		endif()
		set(not_written war3map.wct war3map.lua)
	else()
		set(not_written war3map.wtg war3map.wct war3map.lua)
	endif()
	foreach(name ${not_written})
		if(EXISTS "${kept_output}/${name}")
			message(FATAL_ERROR "--resave of a map without war3map.wtg (${kept_case}) wrote ${name}")
		endif()
	endforeach()
	if(kept_case STREQUAL "scripts" AND EXISTS "${kept_output}/war3map.j")
		message(FATAL_ERROR "--resave of a map with only scripts/war3map.j wrote a war3map.j into the root")
	endif()
	file(REMOVE_RECURSE "${kept_output}")
endforeach()

# Neither war3map.wtg nor a script: nothing to keep, so the script and the trigger files are generated as before.
file(REMOVE_RECURSE "${sandbox}")
file(COPY "${INPUT}/" DESTINATION "${sandbox}")
file(REMOVE "${sandbox}/war3map.wtg" "${sandbox}/war3map.wct" "${sandbox}/war3map.j")
set(generated_output "${OUTPUT}_generated")
file(REMOVE_RECURSE "${generated_output}")
run_resave(result errors "${sandbox}" "${generated_output}")
if(NOT result EQUAL 0 OR errors MATCHES "Saving keeps the map script")
	message(FATAL_ERROR "--resave of a map without trigger data or script exited with ${result}, expected 0 and no kept-script notice: ${errors}")
endif()
foreach(name war3map.wtg war3map.wct war3map.j)
	if(NOT EXISTS "${generated_output}/${name}")
		message(FATAL_ERROR "--resave of a map without trigger data or script did not generate ${name}")
	endif()
endforeach()
file(REMOVE_RECURSE "${generated_output}")

file(REMOVE_RECURSE "${sandbox}")
message("resave_smoke: saved ${OUTPUT}, refusals checked")
