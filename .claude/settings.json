{
  "permissions": {
    "deny": [
      "Read(**/*.pen)",
      "Grep(**/*.pen)",
      "Bash(cmake --build --preset Release*)",
      "PowerShell(cmake --build --preset Release*)",
      "Bash(*cmake*--preset*Release*)",
      "PowerShell(*cmake*--preset*Release*)",
      "Bash(*cmake --build*build/Release*)",
      "PowerShell(*cmake --build*build/Release*)",
      "Bash(*cmake*--preset*Debug*)",
      "PowerShell(*cmake*--preset*Debug*)",
      "Bash(*cmake*--preset*RelWithDebInfo*)",
      "PowerShell(*cmake*--preset*RelWithDebInfo*)",
      "Bash(git push upstream*)",
      "PowerShell(git push upstream*)",
      "Bash(*git push*upstream*)",
      "PowerShell(*git push*upstream*)",
      "Bash(*git push*--force)",
      "Bash(*git push*--force *)",
      "Bash(*git push* -f)",
      "Bash(*git push* -f *)",
      "Bash(*git push*+*)",
      "Bash(*git push*--mirror*)",
      "Bash(*git push* :*)",
      "PowerShell(*git push*--force)",
      "PowerShell(*git push*--force *)",
      "PowerShell(*git push* -f)",
      "PowerShell(*git push* -f *)",
      "PowerShell(*git push*+*)",
      "PowerShell(*git push*--mirror*)",
      "PowerShell(*git push* :*)",
      "Bash(*git push*--delete*main*)",
      "Bash(*git push* -d *main*)",
      "PowerShell(*git push*--delete*main*)",
      "PowerShell(*git push* -d *main*)",
      "Bash(*gh api*refs/heads/main*)",
      "PowerShell(*gh api*refs/heads/main*)",
      "Bash(gh repo edit*--visibility*)",
      "PowerShell(gh repo edit*--visibility*)",
      "Bash(gh auth switch*)",
      "PowerShell(gh auth switch*)",
      "Bash(taskkill*/im HiveWE*)",
      "Bash(taskkill*/IM HiveWE*)",
      "PowerShell(taskkill*/im HiveWE*)",
      "PowerShell(taskkill*/IM HiveWE*)",
      "PowerShell(Stop-Process*-Name HiveWE*)",
      "Bash(taskkill*/im Warcraft*)",
      "Bash(taskkill*/IM Warcraft*)",
      "PowerShell(taskkill*/im Warcraft*)",
      "PowerShell(taskkill*/IM Warcraft*)",
      "PowerShell(Stop-Process*-Name*Warcraft*)",
      "Bash(taskkill*/im code*)",
      "Bash(taskkill*/IM code*)",
      "PowerShell(taskkill*/im code*)",
      "PowerShell(taskkill*/IM code*)",
      "PowerShell(Stop-Process*-Name code*)"
    ],
    "ask": [
      "Bash(*git push*--force-with-lease*)",
      "PowerShell(*git push*--force-with-lease*)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "powershell",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"$CLAUDE_PROJECT_DIR/.claude/tools/stop-guard.ps1\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
