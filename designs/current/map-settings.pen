    {
      "type": "frame",
      "id": "g97j6",
      "x": 3250,
      "y": 3560,
      "name": "Notes / Baseline measurements and bugs",
      "width": 760,
      "fill": "$window-bg",
      "layout": "vertical",
      "gap": 8,
      "padding": 20,
      "children": [
        {
          "type": "text",
          "id": "H0QYD7",
          "name": "Note 1",
          "fill": "$qt-text",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "Measured in the running app, 2026-11-08, display scale 125% (GetDpiForWindow = 120 for every dialog and the main window). Frame px are logical px: capture px / 1.25, minus the 9 px black border at left/right/bottom.",
          "lineHeight": 1.3,
          "fontFamily": "$font-ui",
          "fontSize": 12,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "rjH3C",
          "name": "Note 2",
          "fill": "$qt-text",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "Windows sized (logical): Map Info 582x634, Scenario Properties 1200x750, Gameplay Constants 1000x630, Item Tables 940x670, Config 860x670, Create New Map 760x634, Settings 730x560. Title bar 30 px. Sizes are the dialogs as opened; Map Info and Create New Map are taller than the .ui / resize() values because of content minimums.",
          "lineHeight": 1.3,
          "fontFamily": "$font-ui",
          "fontSize": 12,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "V4OK3B",
          "name": "Note 3",
          "fill": "$qt-text",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "Palette measured from pixels: window #353535, tab page #434343 with 1 px #595959 border, field #2A2A2A, inactive tab #3E3E3E, combo #444444 border #565656, header #3F3F3F, alternate row #424242, selected group row #4B5157, focused search border #53A0ED, checkbox/radio fill #000000, title bar #1A2228.",
          "lineHeight": 1.3,
          "fontFamily": "$font-ui",
          "fontSize": 12,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "wW8xJ",
          "name": "Note 4",
          "fill": "$qt-text",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "APP BUG (confirmed in hivewe.cpp:233-235): the ribbon Loading Screen button opens tab index 1 (Options) and the Options button opens index 2 (Size and Camera Bounds). Map Info tab order is Description, Options, Size and Camera Bounds, Loading Screen, Preferences. Nothing opens the Loading Screen or Preferences tab directly.",
          "lineHeight": 1.3,
          "fontFamily": "$font-ui",
          "fontSize": 12,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "B7nvu6",
          "name": "Note 5",
          "fill": "$qt-text",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "Preferences tab is empty except a lone \"?\" label (capture).",
          "lineHeight": 1.3,
          "fontFamily": "$font-ui",
          "fontSize": 12,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "rYbhf",
          "name": "Note 6",
          "fill": "$qt-text",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "Map Info values are from the sandbox test map (empty name/author/description, Map Version 6, Editor Version 6116). Settings values are the saved settings of this machine (Difficulty Hard, Fixed random Seed on, No Windows Focus Pause on).",
          "lineHeight": 1.3,
          "fontFamily": "$font-ui",
          "fontSize": 12,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "Zwa9O",
          "name": "Note 7",
          "fill": "$qt-text",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "Config window: the 18-row top frame is matched to a capture; the other two Config frames use the same row list from source with a computed scroll position (UNCERTAIN).",
          "lineHeight": 1.3,
          "fontFamily": "$font-ui",
          "fontSize": 12,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "c6KqKE",
          "name": "Note 8",
          "fill": "$qt-text",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "Item Tables: only the empty state was reachable without editing the map. The earlier \"Table selected\" content was replaced by the captured empty state. Edit Drop Item and Unit Properties were not reached (Unit Properties needs a placed non-sloc unit; the sandbox viewport did not open it on a posted double click in selection mode).",
          "lineHeight": 1.3,
          "fontFamily": "$font-ui",
          "fontSize": 12,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "k1KHq",
          "name": "Note 9",
          "fill": "$qt-text",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "Fonts: Open Sans stands in for Segoe UI. Icons: Lucide / Material Symbols stand-ins for arrows and checks; the app icon is the real PNG.",
          "lineHeight": 1.3,
          "fontFamily": "$font-ui",
          "fontSize": 12,
          "fontWeight": "normal"
        }
      ]
    }
  ],
