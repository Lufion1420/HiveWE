                {
                  "type": "text",
                  "id": "IlUw7",
                  "name": "Tooltip Text",
                  "fill": "$qt-text",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Renames every custom model, texture, etc. to a random name and rewrites every reference to it (object data, war3map.w3i, paths inside models, script literals) so the map still plays correctly - defeats tools that recover filenames via a known-name dictionary (e.g. Ladik's MPQ Editor). Core map files, stock game assets, and sound files are never renamed. Aborts the export instead of shipping a map with a broken reference if anything can't be verified.",
                  "fontFamily": "$font-ui",
                  "fontSize": "$font-size-body",
                  "fontWeight": "normal"
                }
